-- ESP highlights needle, teleport drops you on it, auto-win loop holds position to trigger server touch

-- Load Rayfield UI (mobile-friendly)
local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/rayfield"
))()

local Players   = game:GetService("Players")
local RunService= game:GetService("RunService")
local lp        = Players.LocalPlayer

-- ─── Window ───────────────────────────────────────────────────────────────────
local Win = Rayfield:CreateWindow({
    Name             = "Needle Finder",
    LoadingTitle     = "Needle Finder",
    LoadingSubtitle  = "Search & Win",
    ConfigurationSaving = { Enabled = false },
    Discord          = { Enabled = false },
    KeySystem        = false
})

local MainTab = Win:CreateTab("Main",  4483362458)
local InfoTab = Win:CreateTab("Info",  4483362458)

-- ─── Needle Detection ─────────────────────────────────────────────────────────
local NEEDLE_KEYWORDS = { "needle", "pin", "hidden", "findme", "object" }

local function matchesKeyword(name)
    local low = name:lower()
    for _, kw in ipairs(NEEDLE_KEYWORDS) do
        if low:find(kw) then return true end
    end
    return false
end

local function findNeedle()
    local found = nil
    local bestDist = math.huge
    local char = lp.Character
    local origin = char and char:FindFirstChild("HumanoidRootPart")

    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and matchesKeyword(v.Name) then
            local dist = origin
                and (v.Position - origin.Position).Magnitude
                or 0
            if dist < bestDist then
                bestDist = dist
                found = v
            end
        elseif v:IsA("Model") and matchesKeyword(v.Name) then
            local part = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
            if part then
                local dist = origin
                    and (part.Position - origin.Position).Magnitude
                    or 0
                if dist < bestDist then
                    bestDist = dist
                    found = part
                end
            end
        end
    end
    return found
end

-- ─── ESP ──────────────────────────────────────────────────────────────────────
local espHL  = nil
local espBB  = nil

local function clearESP()
    if espHL  then espHL:Destroy();  espHL  = nil end
    if espBB  then espBB:Destroy();  espBB  = nil end
end

local function applyESP(part)
    clearESP()

    -- Highlight overlay
    local hl = Instance.new("Highlight")
    hl.FillColor          = Color3.fromRGB(255, 30, 30)
    hl.OutlineColor       = Color3.fromRGB(255, 220, 0)
    hl.FillTransparency   = 0.25
    hl.OutlineTransparency = 0
    hl.Adornee            = part
    hl.DepthMode          = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent             = part
    espHL = hl

    -- Floating label
    local bb = Instance.new("BillboardGui")
    bb.Size         = UDim2.new(0, 220, 0, 50)
    bb.StudsOffset  = Vector3.new(0, 4, 0)
    bb.AlwaysOnTop  = true
    bb.Adornee      = part
    bb.Parent       = part
    espBB = bb

    local lbl = Instance.new("TextLabel", bb)
    lbl.Size                = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundColor3    = Color3.fromRGB(0, 0, 0)
    lbl.BackgroundTransparency = 0.4
    lbl.TextColor3          = Color3.fromRGB(255, 220, 0)
    lbl.Text                = "NEEDLE IS HERE"
    lbl.TextScaled          = true
    lbl.Font                = Enum.Font.GothamBold

    local corner = Instance.new("UICorner", lbl)
    corner.CornerRadius = UDim.new(0, 6)
end

-- ─── Teleport ─────────────────────────────────────────────────────────────────
local function tpToNeedle(part)
    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
    end
end

-- ─── Auto-Win Loop ────────────────────────────────────────────────────────────
-- Holds character on top of needle every frame so server detects the touch
local autoConn   = nil
local autoActive = false

local function startAutoWin()
    local needle = findNeedle()
    if not needle then
        Rayfield:Notify({
            Title   = "Not Found",
            Content = "No needle in workspace yet. Wait for round start.",
            Duration = 4
        })
        return
    end

    autoActive = true
    tpToNeedle(needle)

    autoConn = RunService.Heartbeat:Connect(function()
        if not autoActive then
            autoConn:Disconnect()
            return
        end
        local n = findNeedle()
        if not n then return end
        local char = lp.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp then
            -- snap onto needle every frame — server detects touch naturally
            hrp.CFrame = CFrame.new(n.Position + Vector3.new(0, 2.5, 0))
        end
        if hum then
            hum:MoveTo(n.Position)
        end
    end)

    Rayfield:Notify({
        Title   = "Auto Win Active",
        Content = "Locked onto needle. Should win shortly.",
        Duration = 3
    })
end

local function stopAutoWin()
    autoActive = false
    if autoConn then autoConn:Disconnect(); autoConn = nil end
end

-- ─── UI: Main Tab ─────────────────────────────────────────────────────────────
MainTab:CreateSection("ESP")

MainTab:CreateToggle({
    Name         = "Needle ESP (Highlight + Label)",
    CurrentValue = false,
    Flag         = "ESP",
    Callback     = function(val)
        if val then
            local n = findNeedle()
            if n then
                applyESP(n)
                Rayfield:Notify({
                    Title   = "ESP On",
                    Content = "Needle highlighted: " .. n.Name,
                    Duration = 3
                })
            else
                Rayfield:Notify({
                    Title   = "ESP",
                    Content = "Needle not in workspace yet.",
                    Duration = 3
                })
            end
        else
            clearESP()
        end
    end
})

MainTab:CreateSection("Win")

MainTab:CreateButton({
    Name     = "Teleport to Needle",
    Callback = function()
        local n = findNeedle()
        if n then
            tpToNeedle(n)
            Rayfield:Notify({
                Title   = "Teleported",
                Content = "Moved to " .. n:GetFullName(),
                Duration = 2
            })
        else
            Rayfield:Notify({
                Title   = "Not Found",
                Content = "Needle not detected. Wait for round.",
                Duration = 3
            })
        end
    end
})

MainTab:CreateToggle({
    Name         = "Auto Win Loop",
    CurrentValue = false,
    Flag         = "AutoWin",
    Callback     = function(val)
        if val then
            startAutoWin()
        else
            stopAutoWin()
            Rayfield:Notify({
                Title   = "Auto Win",
                Content = "Stopped.",
                Duration = 2
            })
        end
    end
})

