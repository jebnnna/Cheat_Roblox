-- build the GUI first
local player = game:GetService("Players").LocalPlayer
local pg = player:WaitForChild("PlayerGui")

if pg:FindFirstChild("VantaDebug") then
    pg:FindFirstChild("VantaDebug"):Destroy()
end

local sg = Instance.new("ScreenGui", pg)
sg.ResetOnSpawn = false
sg.Name = "VantaDebug"

local frame = Instance.new("Frame", sg)
frame.Size = UDim2.new(0.9, 0, 0.5, 0)
frame.Position = UDim2.new(0.05, 0, 0.48, 0)
frame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
frame.BackgroundTransparency = 0.1
frame.BorderSizePixel = 0

local label = Instance.new("TextLabel", frame)
label.Size = UDim2.new(1, -10, 1, -10)
label.Position = UDim2.new(0, 5, 0, 5)
label.BackgroundTransparency = 1
label.TextColor3 = Color3.fromRGB(0, 255, 120)
label.TextScaled = false
label.TextSize = 16
label.Font = Enum.Font.Code
label.TextXAlignment = Enum.TextXAlignment.Left
label.TextYAlignment = Enum.TextYAlignment.Top
label.TextWrapped = true
label.Text = "HOOKED. RUNNING LOADER...\n"

local function log(msg)
    label.Text = label.Text .. msg .. "\n"
end

-- hook BEFORE loader runs
local rh = game.HttpGet
game.HttpGet = function(self, url, ...)
    log("[REQ] " .. tostring(url):sub(1, 80))
    local ok, res = pcall(rh, self, url, ...)
    if not ok then
        log("[ERR] " .. tostring(res))
        return ""
    end
    -- catch the actual payload (not a loader file)
    if url:find("luarmor") and not url:find("loader") then
        log("[SOURCE CAUGHT]")
        getgenv().__source = res
        -- save first 300 chars to screen
        log(tostring(res):sub(1, 300))
    end
    return res
end

-- now fire the loader
getgenv().script_key = "MShRRvuHmzJGmEKuNtpTwCLhEUVoHOXL"
local ok, err = pcall(function()
    loadstring(game:HttpGet("https://api.luarmor.net/files/v4/loaders/2529a5f9dfddd5523ca4e22f21cceffa.lua"))()
end)

if not ok then
    log("[LOADER DEAD] " .. tostring(err))
end

task.wait(5)
if getgenv().__source then
    log("[DONE] source saved to getgenv().__source")
else
    log("[NOTHING CAUGHT] key dead or payload URL pattern different")
end
