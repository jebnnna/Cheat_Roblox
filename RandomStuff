local label = Instance.new("TextLabel", frame)
label.Size = UDim2.new(1, -10, 5, 0)
label.Position = UDim2.new(0, 5, 0, 5)
label.BackgroundTransparency = 1
label.TextColor3 = Color3.fromRGB(0, 255, 120)
label.TextSize = 14
label.Font = Enum.Font.Code
label.TextXAlignment = Enum.TextXAlignment.Left
label.TextYAlignment = Enum.TextYAlignment.Top
label.TextWrapped = true
label.Text = "LOADSTRING HOOK ACTIVE\n"

local function log(msg)
    label.Text = label.Text .. msg .. "\n"
end

-- hook loadstring — fires with decrypted source
local real_ls = loadstring
getgenv().loadstring = function(src, ...)
    log("[LOADSTRING FIRED] len=" .. #src)
    -- save every chunk
    local key = "chunk_" .. tostring(os.clock())
    getgenv()[key] = src
    log("[SAVED TO] getgenv()." .. key)
    -- print first 200 chars to screen
    log(tostring(src):sub(1, 200))
    log("---")
    return real_ls(src, ...)
end

-- now fire the loader
getgenv().script_key = "MShRRvuHmzJGmEKuNtpTwCLhEUVoHOXL"
local ok, err = pcall(function()
    loadstring(game:HttpGet("https://api.luarmor.net/files/v4/loaders/2529a5f9dfddd5523ca4e22f21cceffa.lua"))()
end)

if not ok then
    log("[LOADER ERR] " .. tostring(err))
end
