-- hook HttpGet
local rh = game.HttpGet
game.HttpGet = function(self, url, ...)
    local ok, res = pcall(rh, self, url, ...)
    if not ok then
        log("[HTTP ERR] " .. tostring(res))
        return ""
    end
    if url:find("luarmor") and not url:find("loader") then
        log("[CAUGHT] " .. url:sub(1, 60))
        getgenv().__payload = res
    else
        log("[REQ] " .. url:sub(1, 60))
    end
    return res
end

