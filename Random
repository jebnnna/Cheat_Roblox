local function getToolScore(tool)
    local best = 0

    for _, name in ipairs({
        "Damage",
        "Power",
        "Level",
        "Multiplier",
    }) do
        local attribute = tool:GetAttribute(name)
        if typeof(attribute) == "number" then
            best = math.max(best, attribute)
        end

        local value = tool:FindFirstChild(name)
        if value and (
            value:IsA("NumberValue")
            or value:IsA("IntValue")
        ) then
            best = math.max(best, value.Value)
        end
    end

    return best
end

local function equipBestTool()
    local character = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")

    if not character or not backpack then
        status.Text = "Character or backpack unavailable"
        return
    end

    local bestTool
    local bestScore = -math.huge

    for _, container in ipairs({backpack, character}) do
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local score = getToolScore(item)

                if score > bestScore then
                    bestScore = score
                    bestTool = item
                end
            end
        end
    end

    if bestTool then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:EquipTool(bestTool)
            status.Text = "Equipped: " .. bestTool.Name
        end
    else
        status.Text = "No available tools found"
    end
end

