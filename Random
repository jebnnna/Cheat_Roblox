local function getPromptCategory(prompt)
    local name = prompt.Name:lower()

    if name:find("sell") then
        return "Sell"
    elseif name:find("rank") or name:find("rebirth") then
        return "Rank"
    elseif name:find("weapon") or name:find("sword") then
        return "Weapon"
    elseif name:find("pet") or name:find("egg") then
        return "Pet"
    elseif name:find("bell") or name:find("collect") then
        return "Bells"
    end

    return nil
end

