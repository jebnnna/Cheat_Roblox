            )

            if not part then
                continue
            end

            local distance = (root.Position - part.Position).Magnitude

            if distance <= object.MaxActivationDistance then
                promptBusy[object] = true

                task.spawn(function()
                    local ok = pcall(function()
                        if object.Parent and object.Enabled then
                            object:InputHoldBegin()
                            task.wait(math.max(object.HoldDuration, 0.1))
                            object:InputHoldEnd()
                        end
                    end)

                    task.wait(1)

                    promptBusy[object] = nil
                end)
            end
        end
    end
end)

