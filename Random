-- ── REMOTE PLACEHOLDERS (spy & replace) ─────────────────────
local Remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage
local RankUpRemote    = Remotes:FindFirstChild("RankUp") or Remotes:FindFirstChild("UpgradeRank")
local BuyWeaponRemote = Remotes:FindFirstChild("BuyWeapon") or Remotes:FindFirstChild("PurchaseWeapon")
local EquipWeapon     = Remotes:FindFirstChild("EquipWeapon") or Remotes:FindFirstChild("SelectWeapon")
local SellRemote      = Remotes:FindFirstChild("Sell") or Remotes:FindFirstChild("SellAll")
local BuyPetRemote    = Remotes:FindFirstChild("BuyPet") or Remotes:FindFirstChild("PurchasePet")
local EquipPetRemote  = Remotes:FindFirstChild("EquipPet")
local BuyBellRemote   = Remotes:FindFirstChild("BuyBell") or Remotes:FindFirstChild("PurchaseBell")
local ClaimRemote     = Remotes:FindFirstChild("Claim") or Remotes:FindFirstChild("Collect")

-- ── CONFIG ──────────────────────────────────────────────────
local BEST_WEAPON_NAME = "Shadow Blade"   -- change to current top weapon
local BEST_PET_NAME    = "OwnerDragon"    -- change to your pet name
local SELL_INTERVAL    = 2.5
local RANK_INTERVAL    = 1.2
local WEAPON_INTERVAL  = 3.0
local BELL_INTERVAL    = 4.0

local Auto = {
	Rank   = false,
	Weapon = false,
	Bells  = false,
	Sell   = false,
	Buy    = false,
	Pet    = false,
}

-- ── UI ──────────────────────────────────────────────────────
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "NinjaDeltaUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
pcall(function() ScreenGui.Parent = game:GetService("CoreGui") end)
if not ScreenGui.Parent then ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

local Main = Instance.new("Frame")
Main.Name = "Main"
Main.Size = UDim2.new(0, 260, 0, 340)
Main.Position = UDim2.new(0, 20, 0.5, -170)
Main.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
Main.BorderSizePixel = 0
Main.Parent = ScreenGui
Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 10)

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 36)
Title.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
Title.Text = "NINJA · DELTA AUTO"
Title.TextColor3 = Color3.fromRGB(0, 220, 160)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 15
Title.Parent = Main
Instance.new("UICorner", Title).CornerRadius = UDim.new(0, 10)

local function makeToggle(name, y, key)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -24, 0, 32)
	btn.Position = UDim2.new(0, 12, 0, y)
	btn.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
	btn.Text = name .. "  [OFF]"
	btn.TextColor3 = Color3.fromRGB(200, 200, 210)
	btn.Font = Enum.Font.Gotham
	btn.TextSize = 13
	btn.Parent = Main
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

	btn.MouseButton1Click:Connect(function()
		Auto[key] = not Auto[key]
		btn.Text = name .. (Auto[key] and "  [ON]" or "  [OFF]")
		btn.BackgroundColor3 = Auto[key] and Color3.fromRGB(0, 90, 70) or Color3.fromRGB(40, 40, 52)
	end)
end

makeToggle("Auto Rank",      48,  "Rank")
makeToggle("Best Weapon",    88,  "Weapon")
makeToggle("Auto Bells",     128, "Bells")
makeToggle("Auto Sell",      168, "Sell")
makeToggle("Auto Buy",       208, "Buy")
makeToggle("Force Best Pet", 248, "Pet")

local Status = Instance.new("TextLabel")
Status.Size = UDim2.new(1, -24, 0, 28)
Status.Position = UDim2.new(0, 12, 1, -40)
Status.BackgroundTransparency = 1
Status.Text = "ready"
Status.TextColor3 = Color3.fromRGB(120, 120, 140)
Status.Font = Enum.Font.Gotham
Status.TextSize = 12
Status.Parent = Main

-- drag
local dragging, dragStart, startPos
Main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = Main.Position
	end
end)
Main.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)
UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- ── HELPERS ─────────────────────────────────────────────────
local function safeFire(remote, ...)
	if not remote then return end
	pcall(function(...)
		if remote:IsA("RemoteEvent") then
			remote:FireServer(...)
		elseif remote:IsA("RemoteFunction") then
			remote:InvokeServer(...)
		end
	end, ...)
end

local function setStatus(t)
	Status.Text = t
end

-- ── LOOPS ───────────────────────────────────────────────────
task.spawn(function()
	while true do
		if Auto.Rank then
			safeFire(RankUpRemote)
			setStatus("ranking…")
		end
		task.wait(RANK_INTERVAL)
	end
end)

