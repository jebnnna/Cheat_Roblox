-- ============================================================
-- ESP  (Highlight API — works on all executors post-2022)
-- ============================================================
local ESPHighlights = {}

local function CreateHighlight(char)
    if ESPHighlights[char] then return end
    local hl              = Instance.new("Highlight")
    hl.FillColor          = Config.ESP.FillColor
    hl.OutlineColor       = Config.ESP.OutlineColor
    hl.FillTransparency   = Config.ESP.FillTransp
    hl.OutlineTransparency= Config.ESP.OutlineTransp
    hl.DepthMode          = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent             = char
    ESPHighlights[char]   = hl
end

local function RemoveHighlight(char)
    if ESPHighlights[char] then
        ESPHighlights[char]:Destroy()
        ESPHighlights[char] = nil
    end
end

RunService.Heartbeat:Connect(function()
    -- apply / update
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            if Config.ESP.Enabled then
                CreateHighlight(char)
                local hl = ESPHighlights[char]
                if hl then
                    hl.FillColor           = Config.ESP.FillColor
                    hl.OutlineColor        = Config.ESP.OutlineColor
                    hl.FillTransparency    = Config.ESP.FillTransp
                    hl.OutlineTransparency = Config.ESP.OutlineTransp
                end
            else
                RemoveHighlight(char)
            end
        end
    end
    -- purge stale refs
    for char in pairs(ESPHighlights) do
        if not char.Parent then RemoveHighlight(char) end
    end
end)

-- ============================================================
-- AIMBOT
-- ============================================================
local function GetClosestTarget()
    local vCenter = Camera.ViewportSize / 2
    local bestDist, bestBone = Config.Aimbot.FOV, nil

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer or not plr.Character then continue end
        if Config.Aimbot.TeamCheck and plr.Team == LocalPlayer.Team then continue end

        local char     = plr.Character
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local bone     = char:FindFirstChild(Config.Aimbot.Bone)

        if humanoid and humanoid.Health > 0 and bone then
            local screenPos, onScreen = Camera:WorldToViewportPoint(bone.Position)
            if onScreen then
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - vCenter).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    bestBone = bone
                end
            end
        end
    end
    return bestBone
end

RunService.RenderStepped:Connect(function()
    if not Config.Aimbot.Enabled then return end
    if not UserInputService:IsMouseButtonPressed(Config.Aimbot.HoldKey) then return end
    local target = GetClosestTarget()
    if target then
        local goal = CFrame.new(Camera.CFrame.Position, target.Position)
        Camera.CFrame = Camera.CFrame:Lerp(goal, Config.Aimbot.Smooth)
    end
end)

